# Compose uses this file after it is copied to .env.
# Change these IDs when `id -u` / `id -g` on the host are not 1000.
HOST_UID=1000
HOST_GID=1000

# On native Linux, obtain this with: getent group audio | cut -d: -f3
AUDIO_GID=29

# Models remain outside the image. Relative paths are resolved from this repo.
MODEL_DIR=./models
DATA_DIR=./data

# Device index shown by sounddevice.query_devices() (see the README diagnostic).
PERSIAN_ASSISTANT_MIC_DEVICE=0
PERSIAN_ASSISTANT_LOG_LEVEL=INFO

# The GPU overlay defaults to cu128. Override this for another supported wheel set.
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
